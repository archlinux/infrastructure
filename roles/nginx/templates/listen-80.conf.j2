{% if nginx_stream_deny %}
listen 127.0.0.1:8080 proxy_protocol;
listen [::1]:8080 proxy_protocol;
{% else %}
listen 80{{ ' proxy_protocol' if nginx_proxy_protocol_upstream_host or nginx_proxy_vendor }};
listen [::]:80{{ ' proxy_protocol' if nginx_proxy_protocol_upstream_host or nginx_proxy_vendor }};
{% endif %}
